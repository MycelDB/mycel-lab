{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myceldb.io/schemas/coordinated-release-manifest/v1.schema.json",
  "title": "MycelDB coordinated release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "release", "sources", "artifacts", "outputs", "approvals", "publication"],
  "properties": {
    "apiVersion": {"const": "myceldb.io/coordinated-release-manifest/v1"},
    "kind": {"const": "CoordinatedReleaseManifest"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "createdAt", "candidateId", "qualifiedBundleSHA256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "candidateId": {"type": "string", "minLength": 1},
        "qualifiedBundleSHA256": {"$ref": "#/$defs/sha256"},
        "acceptedBundleSHA256": {"$ref": "#/$defs/sha256"}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "channel", "failureDomain"],
      "properties": {
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "channel": {"enum": ["stable", "preview", "internal"]},
        "failureDomain": {"enum": ["none", "product-correctness", "release-harness", "execution-identity-provenance", "infrastructure", "protected-provider", "publication"]},
        "knownLimitationsPath": {"type": "string", "minLength": 1}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["gitTags", "ociTags", "packages", "checksums", "releaseNotes"],
      "properties": {
        "gitTags": {"type": "array", "items": {"$ref": "#/$defs/gitTag"}},
        "ociTags": {"type": "array", "items": {"$ref": "#/$defs/ociTag"}},
        "packages": {"type": "array", "items": {"$ref": "#/$defs/package"}},
        "consoleArtifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "checksums": {"type": "array", "items": {"$ref": "#/$defs/checksum"}},
        "homebrew": {"type": "array", "items": {"$ref": "#/$defs/homebrewUpdate"}},
        "releaseNotes": {"type": "object", "additionalProperties": false, "required": ["sourcePath", "sha256"], "properties": {"sourcePath": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "approvals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/approval"}},
    "riskAcceptances": {"type": "array", "items": {"$ref": "#/$defs/riskAcceptance"}},
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["stableTagsImmutable", "correctionPolicy"],
      "properties": {
        "stableTagsImmutable": {"const": true},
        "correctionPolicy": {"const": "new-patch-version-only"},
        "resumeFromPartialPublication": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "path", "revision", "tree"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"},
        "dirty": {"const": false}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "uri", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["oci-image", "go-module", "rust-crate", "npm-package", "console-installer", "archive", "other"]},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "digest": {"$ref": "#/$defs/digest"},
        "sourceRepository": {"type": "string", "minLength": 1},
        "sourceRevision": {"$ref": "#/$defs/gitObject"}
      }
    },
    "gitTag": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "targetRevision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "targetRevision": {"$ref": "#/$defs/gitObject"},
        "annotated": {"type": "boolean"}
      }
    },
    "ociTag": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "tag", "digest"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "registry", "version", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "registry": {"enum": ["github", "crates.io", "npm", "dockerhub", "homebrew", "other"]},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checksum": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "homebrewUpdate": {
      "type": "object", "additionalProperties": false,
      "required": ["tap", "formula", "version", "sha256"],
      "properties": {
        "tap": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "consumption", "approvedAt", "approvedBy"],
      "properties": {
        "scope": {"enum": ["credential-free-qualification", "product-candidate-construction", "protected-release-gate", "protected-live-provider", "publication-git-tags", "publication-full", "risk-accepted-publication"]},
        "consumption": {"const": "one-shot"},
        "approvedAt": {"type": "string", "format": "date-time"},
        "approvedBy": {"type": "string", "minLength": 1},
        "externalApprovalId": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "riskAcceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["failureDomain", "failedGate", "evidenceURI", "publishedDigests", "knownLimitationsPath", "publicationScope", "approval"],
      "properties": {
        "failureDomain": {"enum": ["release-harness", "execution-identity-provenance", "infrastructure", "protected-provider", "publication"]},
        "failedGate": {"type": "string", "minLength": 1},
        "evidenceURI": {"type": "string", "minLength": 1},
        "publishedDigests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
        "knownLimitationsPath": {"type": "string", "minLength": 1},
        "publicationScope": {"enum": ["git-tags-only", "full-publication"]},
        "approval": {"$ref": "#/$defs/approval"}
      }
    }
  }
}
