{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myceldb:mycel-lab:schema:semantic-corpus:v1alpha1",
  "title": "Mycel Lab semantic corpus v1alpha1",
  "description": "A provider-neutral synthetic graph corpus, mutation sequence, and semantic query oracle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "classification",
    "scopes",
    "nodes",
    "mutations",
    "queries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reliability.mycel.io/semantic-corpus/v1alpha1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"$ref": "#/$defs/key"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataClass", "artifactCaptureSafe"],
      "properties": {
        "dataClass": {
          "enum": ["synthetic", "public", "confidential"]
        },
        "artifactCaptureSafe": {"type": "boolean"}
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scope"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "default": [],
      "items": {"$ref": "#/$defs/edge"}
    },
    "mutations": {
      "type": "array",
      "items": {"$ref": "#/$defs/mutation"}
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/query"}
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "spaceKey", "domainKey"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "spaceKey": {"$ref": "#/$defs/key"},
        "domainKey": {"$ref": "#/$defs/key"}
      }
    },
    "projectionExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includedPaths", "excludedPaths", "fixtureTokens"],
      "properties": {
        "includedPaths": {"$ref": "#/$defs/stringSet"},
        "excludedPaths": {"$ref": "#/$defs/stringSet"},
        "fixtureTokens": {"$ref": "#/$defs/stringSet"},
        "expectedEligible": {"type": "boolean", "default": true}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scopeKey", "labels", "properties", "projection"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "scopeKey": {"$ref": "#/$defs/key"},
        "labels": {"$ref": "#/$defs/stringSet"},
        "properties": {"type": "object"},
        "projection": {"$ref": "#/$defs/projectionExpectation"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scopeKey", "fromNodeKey", "toNodeKey", "labels", "properties"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "scopeKey": {"$ref": "#/$defs/key"},
        "fromNodeKey": {"$ref": "#/$defs/key"},
        "toNodeKey": {"$ref": "#/$defs/key"},
        "labels": {"$ref": "#/$defs/stringSet"},
        "properties": {"type": "object"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetKey"],
      "properties": {
        "type": {
          "enum": [
            "create-node",
            "update-node",
            "delete-node",
            "create-edge",
            "update-edge",
            "delete-edge"
          ]
        },
        "targetKey": {"$ref": "#/$defs/key"},
        "scopeKey": {"$ref": "#/$defs/key"},
        "fromNodeKey": {"$ref": "#/$defs/key"},
        "toNodeKey": {"$ref": "#/$defs/key"},
        "labels": {"$ref": "#/$defs/stringSet"},
        "setProperties": {"type": "object"},
        "deleteProperties": {"$ref": "#/$defs/stringSet"}
      }
    },
    "mutationExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphChangedKeys",
        "graphUnchangedKeys",
        "semanticChangedKeys",
        "semanticUnchangedKeys"
      ],
      "properties": {
        "graphChangedKeys": {"$ref": "#/$defs/stringSet"},
        "graphUnchangedKeys": {"$ref": "#/$defs/stringSet"},
        "semanticChangedKeys": {"$ref": "#/$defs/stringSet"},
        "semanticUnchangedKeys": {"$ref": "#/$defs/stringSet"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "disposition", "operations", "expected"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "disposition": {
          "enum": ["commit", "rollback", "abort", "failed-statement"]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/operation"}
        },
        "expected": {"$ref": "#/$defs/mutationExpectation"}
      }
    },
    "queryExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderedNodeKeys",
        "absentNodeKeys",
        "requireRecordIdentity",
        "requireSemanticSource"
      ],
      "properties": {
        "orderedNodeKeys": {
          "type": "array",
          "items": {"$ref": "#/$defs/key"}
        },
        "absentNodeKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/key"}
        },
        "exactScores": {
          "type": "array",
          "items": {"type": "number"}
        },
        "scoreTolerance": {"type": "number", "minimum": 0},
        "requireRecordIdentity": {"type": "boolean"},
        "requireSemanticSource": {"type": "boolean"},
        "requiredMutationKey": {"$ref": "#/$defs/key"}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "scopeKey",
        "text",
        "semanticRuleKey",
        "bindingKey",
        "limit",
        "proofLevel",
        "expected"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "scopeKey": {"$ref": "#/$defs/key"},
        "text": {"type": "string", "minLength": 1, "maxLength": 8192},
        "semanticRuleKey": {"$ref": "#/$defs/key"},
        "bindingKey": {"$ref": "#/$defs/key"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10000},
        "minScore": {"type": "number"},
        "proofLevel": {"type": "integer", "minimum": 1, "maximum": 3},
        "expected": {"$ref": "#/$defs/queryExpectation"}
      }
    }
  }
}
