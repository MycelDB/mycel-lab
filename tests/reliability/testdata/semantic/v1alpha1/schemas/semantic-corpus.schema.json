{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myceldb:mycel-lab:schema:semantic-corpus:v1alpha1",
  "title": "Mycel Lab semantic corpus v1alpha1",
  "description": "A provider-neutral synthetic graph corpus, mutation sequence, and semantic query oracle.",
  "x-mycel-decoder-limits": {
    "maxDocumentBytes": 4194304,
    "maxNestingDepth": 16,
    "maxStringUtf8Bytes": 65536,
    "maxObjectProperties": 256,
    "maxNestedArrayItems": 256
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "classification",
    "scopes",
    "nodes",
    "mutations",
    "queries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reliability.mycel.io/semantic-corpus/v1alpha1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"$ref": "#/$defs/key"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataClass", "artifactCaptureSafe"],
      "properties": {
        "dataClass": {
          "enum": ["synthetic", "public", "confidential"]
        },
        "artifactCaptureSafe": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"artifactCaptureSafe": {"const": true}},
            "required": ["artifactCaptureSafe"]
          },
          "then": {
            "properties": {"dataClass": {"const": "synthetic"}}
          }
        }
      ]
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scope"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 20000,
      "default": [],
      "items": {"$ref": "#/$defs/edge"}
    },
    "mutations": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/mutation"}
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/query"}
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "stringSet": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string", "maxLength": 65536},
        {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {"$ref": "#/$defs/jsonObject"}
      ]
    },
    "jsonObject": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "nonEmptyJsonObject": {
      "$ref": "#/$defs/jsonObject",
      "minProperties": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "spaceKey", "domainKey"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "spaceKey": {"$ref": "#/$defs/key"},
        "domainKey": {"$ref": "#/$defs/key"}
      }
    },
    "projectionExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includedPaths", "excludedPaths", "fixtureTokens"],
      "properties": {
        "includedPaths": {"$ref": "#/$defs/stringSet"},
        "excludedPaths": {"$ref": "#/$defs/stringSet"},
        "fixtureTokens": {"$ref": "#/$defs/stringSet"},
        "expectedEligible": {"type": "boolean", "default": true}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scopeKey", "labels", "properties", "projection"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "scopeKey": {"$ref": "#/$defs/key"},
        "labels": {"$ref": "#/$defs/labels"},
        "properties": {"$ref": "#/$defs/jsonObject"},
        "projection": {"$ref": "#/$defs/projectionExpectation"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scopeKey", "fromNodeKey", "toNodeKey", "labels", "properties"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "scopeKey": {"$ref": "#/$defs/key"},
        "fromNodeKey": {"$ref": "#/$defs/key"},
        "toNodeKey": {"$ref": "#/$defs/key"},
        "labels": {"$ref": "#/$defs/labels"},
        "properties": {"$ref": "#/$defs/jsonObject"}
      }
    },
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/createNodeOperation"},
        {"$ref": "#/$defs/updateNodeOperation"},
        {"$ref": "#/$defs/deleteNodeOperation"},
        {"$ref": "#/$defs/createEdgeOperation"},
        {"$ref": "#/$defs/updateEdgeOperation"},
        {"$ref": "#/$defs/deleteEdgeOperation"}
      ]
    },
    "createNodeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetKey", "scopeKey", "labels", "setProperties"],
      "properties": {
        "type": {"const": "create-node"},
        "targetKey": {"$ref": "#/$defs/key"},
        "scopeKey": {"$ref": "#/$defs/key"},
        "labels": {"$ref": "#/$defs/labels"},
        "setProperties": {"$ref": "#/$defs/jsonObject"}
      }
    },
    "updateNodeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetKey"],
      "properties": {
        "type": {"const": "update-node"},
        "targetKey": {"$ref": "#/$defs/key"},
        "labels": {"$ref": "#/$defs/labels"},
        "setProperties": {"$ref": "#/$defs/nonEmptyJsonObject"},
        "deleteProperties": {"$ref": "#/$defs/nonEmptyStringSet"}
      },
      "anyOf": [
        {"required": ["labels"]},
        {"required": ["setProperties"]},
        {"required": ["deleteProperties"]}
      ]
    },
    "deleteNodeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetKey"],
      "properties": {
        "type": {"const": "delete-node"},
        "targetKey": {"$ref": "#/$defs/key"}
      }
    },
    "createEdgeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetKey", "scopeKey", "fromNodeKey", "toNodeKey", "labels", "setProperties"],
      "properties": {
        "type": {"const": "create-edge"},
        "targetKey": {"$ref": "#/$defs/key"},
        "scopeKey": {"$ref": "#/$defs/key"},
        "fromNodeKey": {"$ref": "#/$defs/key"},
        "toNodeKey": {"$ref": "#/$defs/key"},
        "labels": {"$ref": "#/$defs/labels"},
        "setProperties": {"$ref": "#/$defs/jsonObject"}
      }
    },
    "updateEdgeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetKey"],
      "properties": {
        "type": {"const": "update-edge"},
        "targetKey": {"$ref": "#/$defs/key"},
        "labels": {"$ref": "#/$defs/labels"},
        "setProperties": {"$ref": "#/$defs/nonEmptyJsonObject"},
        "deleteProperties": {"$ref": "#/$defs/nonEmptyStringSet"}
      },
      "anyOf": [
        {"required": ["labels"]},
        {"required": ["setProperties"]},
        {"required": ["deleteProperties"]}
      ]
    },
    "deleteEdgeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetKey"],
      "properties": {
        "type": {"const": "delete-edge"},
        "targetKey": {"$ref": "#/$defs/key"}
      }
    },
    "mutationExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphChangedKeys",
        "graphUnchangedKeys",
        "semanticChangedKeys",
        "semanticUnchangedKeys"
      ],
      "properties": {
        "graphChangedKeys": {"$ref": "#/$defs/stringSet"},
        "graphUnchangedKeys": {"$ref": "#/$defs/stringSet"},
        "semanticChangedKeys": {"$ref": "#/$defs/stringSet"},
        "semanticUnchangedKeys": {"$ref": "#/$defs/stringSet"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "disposition", "operations", "expected"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "disposition": {
          "enum": ["commit", "rollback", "abort", "failed-statement"]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/operation"}
        },
        "expected": {"$ref": "#/$defs/mutationExpectation"}
      }
    },
    "queryExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderedNodeKeys",
        "absentNodeKeys",
        "requireRecordIdentity",
        "requireSemanticSource"
      ],
      "properties": {
        "orderedNodeKeys": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/key"}
        },
        "absentNodeKeys": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/key"}
        },
        "exactScores": {
          "type": "array",
          "maxItems": 10000,
          "items": {"type": "number"}
        },
        "scoreTolerance": {"type": "number", "minimum": 0},
        "requireRecordIdentity": {"type": "boolean"},
        "requireSemanticSource": {"type": "boolean"},
        "requiredMutationKey": {"$ref": "#/$defs/key"}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "scopeKey",
        "text",
        "semanticRuleKey",
        "bindingKey",
        "limit",
        "proofLevel",
        "expected"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "scopeKey": {"$ref": "#/$defs/key"},
        "text": {"type": "string", "minLength": 1, "maxLength": 8192},
        "semanticRuleKey": {"$ref": "#/$defs/key"},
        "bindingKey": {"$ref": "#/$defs/key"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10000},
        "minScore": {"type": "number"},
        "proofLevel": {"type": "integer", "minimum": 1, "maximum": 3},
        "expected": {"$ref": "#/$defs/queryExpectation"}
      }
    }
  }
}
