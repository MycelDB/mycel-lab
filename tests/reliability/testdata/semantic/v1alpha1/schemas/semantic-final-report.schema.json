{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myceldb:mycel-lab:schema:semantic-final-report:v1alpha1",
  "title": "Mycel Lab semantic final report v1alpha1",
  "description": "The gating semantic oracle report. Required not-run assertions cannot produce assertionsOk=true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "scenario",
    "proofLevel",
    "assertionsOk",
    "summary",
    "gates",
    "assertions",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reliability.mycel.io/semantic-final-report/v1alpha1"
    },
    "runId": {"type": "string", "minLength": 1, "maxLength": 256},
    "scenario": {"type": "string", "minLength": 1, "maxLength": 256},
    "proofLevel": {"type": "integer", "minimum": 1, "maximum": 3},
    "assertionsOk": {"type": "boolean"},
    "summary": {"$ref": "#/$defs/summary"},
    "gates": {"$ref": "#/$defs/gates"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactReference"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "passed", "failed", "notRun"],
      "properties": {
        "required": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "notRun": {"type": "integer", "minimum": 0}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph", "semantic", "budget", "redaction", "artifacts"],
      "properties": {
        "graph": {"type": "boolean"},
        "semantic": {"type": "boolean"},
        "budget": {"type": "boolean"},
        "redaction": {"type": "boolean"},
        "artifacts": {"type": "boolean"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "required",
        "proofLevel",
        "status",
        "evidenceRefs"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "required": {"type": "boolean"},
        "proofLevel": {"type": "integer", "minimum": 0, "maximum": 3},
        "status": {"enum": ["pass", "fail", "not-run"]},
        "reasonSanitized": {"type": "string", "maxLength": 4096},
        "evidenceRefs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
