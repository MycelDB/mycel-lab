{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myceldb:mycel-lab:schema:semantic-final-report:v1alpha1",
  "title": "Mycel Lab semantic final report v1alpha1",
  "description": "The gating semantic oracle report. Required failed/not-run assertions or false gates cannot produce assertionsOk=true.",
  "x-mycel-decoder-limits": {
    "maxDocumentBytes": 4194304,
    "maxNestingDepth": 16,
    "maxStringUtf8Bytes": 65536,
    "maxAssertions": 10000,
    "maxArtifactReferences": 10000,
    "maxEvidenceReferencesPerAssertion": 256
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "scenario",
    "proofLevel",
    "assertionsOk",
    "summary",
    "gates",
    "assertions",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reliability.mycel.io/semantic-final-report/v1alpha1"
    },
    "runId": {"type": "string", "minLength": 1, "maxLength": 256},
    "scenario": {"type": "string", "minLength": 1, "maxLength": 256},
    "proofLevel": {"type": "integer", "minimum": 1, "maximum": 3},
    "assertionsOk": {"type": "boolean"},
    "summary": {"$ref": "#/$defs/summary"},
    "gates": {"$ref": "#/$defs/gates"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/artifactReference"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"assertionsOk": {"const": true}},
        "required": ["assertionsOk"]
      },
      "then": {
        "properties": {
          "summary": {
            "properties": {
              "failed": {"const": 0},
              "notRun": {"const": 0}
            }
          },
          "gates": {
            "properties": {
              "graph": {"const": true},
              "semantic": {"const": true},
              "budget": {"const": true},
              "redaction": {"const": true},
              "artifacts": {"const": true}
            }
          },
          "assertions": {
            "items": {
              "if": {
                "properties": {"required": {"const": true}},
                "required": ["required"]
              },
              "then": {
                "properties": {
                  "status": {"const": "pass"},
                  "evidenceRefs": {"minItems": 1}
                }
              }
            }
          },
          "artifacts": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "passed", "failed", "notRun"],
      "properties": {
        "required": {"type": "integer", "minimum": 0, "maximum": 10000},
        "passed": {"type": "integer", "minimum": 0, "maximum": 10000},
        "failed": {"type": "integer", "minimum": 0, "maximum": 10000},
        "notRun": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph", "semantic", "budget", "redaction", "artifacts"],
      "properties": {
        "graph": {"type": "boolean"},
        "semantic": {"type": "boolean"},
        "budget": {"type": "boolean"},
        "redaction": {"type": "boolean"},
        "artifacts": {"type": "boolean"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "required",
        "proofLevel",
        "status",
        "evidenceRefs"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "required": {"type": "boolean"},
        "proofLevel": {"type": "integer", "minimum": 0, "maximum": 3},
        "status": {"enum": ["pass", "fail", "not-run"]},
        "reasonSanitized": {"type": "string", "maxLength": 4096},
        "evidenceRefs": {
          "type": "array",
          "maxItems": 256,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.#=-]*(/[A-Za-z0-9][A-Za-z0-9_.#=-]*)*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
